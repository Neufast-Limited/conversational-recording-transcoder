AWS_REGION=ap-southeast-1
AWS_PROFILE=default

# Bucket the browser recording chunks and manifests are uploaded to
CVI_RECORDING_BUCKET_NAME=
# Bucket holding transcript.json; the MP4 is written here as {interview_id}/{interview_id}.mp4
AWS_BUCKET_NAME=
# FIFO queue that triggers conversational-ai-lambda-processing
SCORING_QUEUE_URL=

# Optional tuning
# SCRATCH_DIR=/tmp
# FFMPEG_TIMEOUT_SECONDS=780
# DOWNLOAD_CONCURRENCY=8

# Optional alternative to a local AWS profile or an IAM role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
